<?xml version="1.0" encoding="utf-8"?>
<!--
  Backend coverage (coverlet collector "XPlat Code Coverage"), used by test.ps1 in the full and release tiers.
  Measured: the four app assemblies only (not the tests, not the Web stub). Excluded: EF migrations (generated by
  dotnet ef) and generated code ([GeneratedCode]). [CompilerGenerated] is NOT excluded: async methods are
  compiler-generated state machines, so excluding it would drop every handler body. The gates (design D5) are computed
  by tests/tools/coverage/coverage-gates.ps1 from the merged Cobertura report.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[ClinicHub.Domain]*,[ClinicHub.Application]*,[ClinicHub.Infrastructure]*,[ClinicHub.Api]*</Include>
          <Exclude>[ClinicHub.Infrastructure]ClinicHub.Infrastructure.Migrations.*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

    <_ContentIncludedByDefault Remove="wwwroot\assets\DrugGroupEditorPage-BVlGSDUe.js" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\DrugGroupsPage-Cvn8PduC.js" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\DrugsPage-Hgpy1KpI.js" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\EditorContent-CkbfgUCq.css" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\EditorContent-Dptgc-Y0.js" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\EditOutlined-CkiwYLx5.js" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\errors-Ch3wkLVn.js" />
    <_ContentIncludedByDefault Remove="wwwroot\assets\index-BCFwL08u.js" />
